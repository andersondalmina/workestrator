{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".github/instructions/*.instructions.md"],
  "formatter": true,
  "permission": {
    "bash": {
      "*": "allow",

      "npm test*": "allow",
      "npm run *": "allow",
      "npm ci": "allow",
      "make *": "allow",
      "npx vitest*": "allow",
      "npx tsc*": "allow",
      "npx prettier*": "allow",
      "npx eslint*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git worktree list*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr diff*": "allow",
      "glab mr list*": "allow",
      "glab mr view*": "allow",

      "git push*": "ask",
      "git commit*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh pr edit*": "ask",
      "gh pr comment*": "ask",
      "gh issue*": "ask",
      "gh release*": "ask",
      "glab mr create*": "ask",
      "glab mr merge*": "ask",
      "glab mr close*": "ask",
      "glab mr note*": "ask",
      "npm install *": "ask",
      "npm i *": "ask",
      "npm add *": "ask",
      "npm publish*": "ask",
      "npm run publish*": "ask",

      "rm -r*": "deny",
      "rm -fr*": "deny",
      "rm -Rf*": "deny",
      "rm -fR*": "deny",
      "rm --recursive *": "deny",
      "rm /*": "deny",
      "rm ~*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git clean -d*": "deny",
      "git clean -x*": "deny",
      "git checkout -- .": "deny",
      "git branch -D*": "deny",
      "git worktree remove --force*": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push * --force*": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "chmod 777*": "deny",
      "chmod -R 777*": "deny"
    }
  }
}
